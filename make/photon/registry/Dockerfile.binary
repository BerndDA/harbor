ARG golang_image
FROM ${golang_image}

WORKDIR /src
COPY . /src

# distribution v3 is a Go module with vendored deps; oss/swift drivers no longer exist
RUN CGO_ENABLED=0 GOFLAGS=-mod=vendor go build -trimpath \
    -ldflags "-s -w -X github.com/distribution/distribution/v3/version.version=$(git describe --match 'v[0-9]*' --always 2>/dev/null || echo unknown)" \
    -o /out/registry ./cmd/registry
